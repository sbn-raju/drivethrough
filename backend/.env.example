# ---------------------------------------------------------------------------
# DriveThrough API — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (strict CORS).
CORS_ORIGINS=http://localhost:5173
# Set to 1 (or a hop count) when running behind a reverse proxy / load balancer.
TRUST_PROXY=0

# Supabase Postgres (Project Settings -> Database -> Connection string).
# Runtime: transaction pooler (port 6543) is fine — prepared statements are disabled.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations: use the direct connection or session pooler (port 5432).
DATABASE_POOL_MAX=10
DATABASE_MIGRATION_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Secrets — generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
OTP_PEPPER=
# 32 bytes, base64 — node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=600

# Supabase Storage for KYC documents (private bucket). Server-side only — never expose to the browser.
# If left empty in non-production, uploads are stored as clearly-labelled synthetic (dummy KYC) records.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KYC_BUCKET=driver-documents
